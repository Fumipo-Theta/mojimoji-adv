{
  "name": "@mojimoji/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@mojimoji/protocol": "0.1.0",
    "hono": "^4.6.14",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:web": "npm run dev --workspace @mojimoji/web",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --build"
  }
}
