{
  "name": "mojimoji-adv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "もじもじアドベンチャー - 紙に書いた手書き文字でモジモンを育てて戦うリアル連携型ゲーム",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace @mojimoji/server",
    "dev:web": "npm run dev --workspace @mojimoji/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build && tsc -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:cert": "node apps/server/scripts/setup-cert.mjs",
    "sheet-gen": "npm run start --workspace @mojimoji/sheet-gen",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
